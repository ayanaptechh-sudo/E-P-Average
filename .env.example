# Environment Variables Example for PromptShield
# Local-first operation runs 100% in-memory with sql.js without external keys required.

VITE_APP_ENV=development

# Optional Online Sync Database (Supabase)
# If provided, enables cloud credential verification, offline caching to sql.js, and real-time status revocation.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key
